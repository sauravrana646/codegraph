{
  "name": "codegraph",
  "version": "0.1.0",
  "private": true,
  "description": "Python-first codebase intelligence platform for IDE and AI workflows.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "tsc -b --pretty false",
    "lint": "npm run lint --workspaces --if-present",
    "package:skill": "bash skills/codegraph/scripts/package-skill.sh",
    "package:extension": "npm run build && npm run package --workspace codegraph-ide-vscode",
    "install:skill": "bash skills/codegraph/scripts/install-skill.sh"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
