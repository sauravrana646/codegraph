{
  "name": "@codegraph/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP adapter exposing Codegraph deterministic tools over stdio.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codegraph-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@codegraph/agent-tools": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
