{
  "name": "codegraph-ide-vscode",
  "displayName": "Codegraph",
  "version": "0.1.0",
  "private": true,
  "publisher": "codegraph",
  "description": "Python-first codebase intelligence extension for VS Code and Cursor.",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/sauravrana646/codegraph.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "python",
    "codebase intelligence",
    "explain code",
    "find references",
    "cursor",
    "codegraph"
  ],
  "activationEvents": [
    "onCommand:codegraph.explainSelection",
    "onCommand:codegraph.findDefinition",
    "onCommand:codegraph.findUsages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codegraph.explainSelection",
        "title": "Codegraph: Explain Selection"
      },
      {
        "command": "codegraph.findDefinition",
        "title": "Codegraph: Find Definition"
      },
      {
        "command": "codegraph.findUsages",
        "title": "Codegraph: Find Usages"
      }
    ],
    "configuration": {
      "title": "Codegraph",
      "properties": {
        "codegraph.enrichment.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable optional model-backed explanation enrichment."
        },
        "codegraph.enrichment.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for OpenAI-compatible enrichment provider."
        },
        "codegraph.enrichment.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for the OpenAI-compatible enrichment provider."
        },
        "codegraph.enrichment.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model name used for explanation enrichment."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node ./esbuild.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run bundle && npx --yes @vscode/vsce package --no-dependencies --out ../../artifacts/codegraph-extension.vsix"
  },
  "dependencies": {
    "@codegraph/core": "0.1.0",
    "@codegraph/model-gateway": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "esbuild": "^0.25.9"
  },
  "files": [
    "dist/extension.js",
    "python_symbol_parser.py",
    "README.md",
    "LICENSE"
  ]
}
